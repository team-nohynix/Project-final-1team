    {
      "id": 208,
      "title": "인프라 리소스 상태 (CloudWatch — Kafka/MySQL/Redis)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "description": "RDS/Redis는 대표로 instance-1/001 인스턴스 값만 표시합니다. Kafka는 SumOffsetLag이 클러스터 단위가 아니라 (Consumer Group, Topic) 조합별로만 발행돼서, 여기선 orderapi-executions 그룹 하나만 대표로 봅니다 — matching-engine은 컨슈머 그룹 밖에서 직접 읽어(matching/kafkaclient/consumer.go) 이 지표 자체에 안 잡히므로 자체 matching_engine_lag 패널로 봐야 합니다.",
      "options": {
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "데이터 없음"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 100000
                    }
                  ]
                }
              },
              {
                "id": "displayName",
                "value": "Kafka 브로커 (SumOffsetLag)"
              },
              {
                "id": "noValue",
                "value": "랙 없음 (정상 — MSK 유휴 시 미발행)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 80
                    }
                  ]
