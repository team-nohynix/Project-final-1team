    {
      "id": 313,
      "title": "매칭 엔진 스케일 상태 (최근 2분 증감)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 60 },
      "datasource": "Prometheus",
      "options": {
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "graphMode": "area",
        "text": { "titleSize": 14, "valueSize": 20 }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [
            { "type": "range", "options": { "from": -1000, "to": -0.01, "result": { "text": "▼ 스케일 인 중 (감소)", "color": "blue" } } },
            { "type": "range", "options": { "from": -0.01, "to": 0.01, "result": { "text": "안정", "color": "green" } } },
            { "type": "range", "options": { "from": 0.01, "to": 1000, "result": { "text": "▲ 스케일 아웃 중 (증가)", "color": "orange" } } }
          ]
        }
      },
      "targets": [
        { "expr": "delta(kube_deployment_status_replicas{exported_namespace=\"backend\", deployment=\"matching-engine\"}[2m])", "legendFormat": "증감" }
      ]
    },
    {
