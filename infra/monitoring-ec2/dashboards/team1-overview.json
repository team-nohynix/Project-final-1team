      "options": {
        "mode": "html",
        "content": "<div style=\"position:relative;width:100%;height:280px;border-radius:8px;overflow:hidden;\"><canvas style=\"width:100%;height:100%;display:block;\"></canvas><img src=\"//:0\" alt=\"\" style=\"display:none\" onerror=\"(function(root){\n  try {\n    var wrap = root.parentElement;\n    if (wrap.dataset.trussFlowInit) return;\n    wrap.dataset.trussFlowInit = '1';\n    var canvas = wrap.querySelector('canvas');\n    var ctx = canvas.getContext('2d');\n    var dpr = window.devicePixelRatio || 1;\n    var trailNeedsReset = true;\n    function resize(){\n      var r = wrap.getBoundingClientRect();\n      canvas.width = Math.max(r.width,10) * dpr;\n      canvas.height = Math.max(r.height,10) * dpr;\n      canvas.style.width = r.width + 'px';\n      canvas.style.height = r.height + 'px';\n      ctx.setTransform(dpr,0,0,dpr,0,0);\n      trailNeedsReset = true;\n    }\n    resize();\n    window.addEventListener('resize', resize);\n\n    // 실제 토폴로지 그대로: orders 토픽에서 matching-engine과 recorder가 각자\n    // 독립적으로 병렬 구독하고(recorder가 matching-engine을 거쳐 받는 게 아님),\n    // matching-engine이 만든 executions 토픽도 recorder가 별도로 구독해서\n    // 두 스트림을 recorder가 합쳐 MySQL에 쓴다.\n    var nodes = [\n      {x:0.04, label:'접수', sub:'orderapi', lane:'trunk'},\n      {x:0.20, label:'Orders 토픽', sub:'Kafka', lane:'trunk'},\n      {x:0.48, label:'매칭 엔진', sub:'matching-engine', lane:'upper'},\n      {x:0.66, label:'Executions 토픽', sub:'Kafka', lane:'upper'},\n      {x:0.81, label:'기록기', sub:'recorder', lane:'trunk'},\n      {x:0.95, label:'MySQL', sub:'trade_order', lane:'trunk'}\n    ];\n    var necks = [\n      {x:0.32, lane:'upper', key:'m',  label:'매칭 컨슈머 랙'},\n      {x:0.32, lane:'lower', key:'ro', label:'기록기 컨슈머(orders) 랙'},\n      {x:0.70, lane:'upper', key:'re', label:'기록기 컨슈머(executions) 랙'}\n    ];\n    var thresholds = { m:500, ro:1000, re:1000 };\n    var glow = nodes.map(function(){return 0;});\n\n    var acceptTps = 0, execTps = 0;\n    var st = { mLag:0, mBP:0, roLag:0, reLag:0, rBP:0, m:0, ro:0, re:0 };\n    function recompute(){\n      st.m  = Math.max(Math.min(st.mLag/thresholds.m, 1), st.mBP ? 1 : 0);\n      st.ro = Math.max(Math.min(st.roLag/thresholds.ro, 1), st.rBP ? 1 : 0);\n      st.re = Math.max(Math.min(st.reLag/thresholds.re, 1), st.rBP ? 1 : 0);\n    }\n    function extreme(key, lag){ return lag > thresholds[key] * 5; }\n\n    function q(expr){\n      return fetch('/api/datasources/proxy/uid/prometheus/api/v1/query?query=' + encodeURIComponent(expr))\n        .then(function(r){ return r.json(); })\n        .then(function(j){\n          if (j &amp;&amp; j.data &amp;&amp; j.data.result &amp;&amp; j.data.result[0]) {\n            var v = parseFloat(j.data.result[0].value[1]);\n            return isFinite(v) ? v : 0;\n          }\n          return 0;\n        }).catch(function(){ return 0; });\n    }\n    function poll(){\n      q('recorder_order_accept_tps').then(function(v){ acceptTps = v; });\n      q('recorder_execution_tps').then(function(v){ execTps = v; });\n      q('matching_engine_lag').then(function(v){ st.mLag = v; recompute(); });\n      q('matching_backpressure_active').then(function(v){ st.mBP = v; recompute(); });\n      q('recorder_consumer_lag{reader=&quot;orders&quot;}').then(function(v){ st.roLag = v; recompute(); });\n      q('recorder_consumer_lag{reader=&quot;executions&quot;}').then(function(v){ st.reLag = v; recompute(); });\n      q('recorder_backpressure_active').then(function(v){ st.rBP = v; recompute(); });\n    }\n    poll();\n    setInterval(poll, 4000);\n\n    function smoothstep(e0,e1,x){\n      var t = Math.min(Math.max((x-e0)/(e1-e0),0),1);\n      return t*t*(3-2*t);\n    }\n    var branchStart=0.15, branchEnd=0.21, mergeStart=0.76, mergeEnd=0.815;\n    function laneBlend(xFrac){\n      if (xFrac < branchStart) return 0;\n      if (xFrac < branchEnd) return smoothstep(branchStart,branchEnd,xFrac);\n      if (xFrac < mergeStart) return 1;\n      if (xFrac < mergeEnd) return 1 - smoothstep(mergeStart,mergeEnd,xFrac);\n      return 0;\n    }\n    function laneCenterFrac(xFrac, lane){\n      if (lane === 'trunk') return 0.5;\n      var blend = laneBlend(xFrac);\n      var off = lane === 'upper' ? -0.20 : 0.20;\n      return 0.5 + off*blend;\n    }\n    function congestionAtLane(xFrac, lane){\n      var c = 0;\n      for (var i=0;i<necks.length;i++){\n        var n = necks[i];\n        if (n.lane !== lane) continue;\n        var cv = st[n.key];\n        var dist = Math.abs(xFrac - n.x);\n        var radius = 0.11;\n        if (dist < radius &amp;&amp; cv > 0){\n          var t = 1 - dist/radius;\n          c = Math.max(c, cv*t);\n        }\n      }\n      return c;\n    }\n    function bandHalfFrac(xFrac, lane){\n      return 0.135 * (1 - congestionAtLane(xFrac, lane) * 0.85);\n    }\n    function neckColorFor(key, lag){\n      var cv = st[key];\n      if (extreme(key, lag)) return '#ff2e6b';\n      if (cv > 0.66) return '#ff6b6b';\n      if (cv > 0.3) return '#ffb84d';\n      return '#3478f6';\n    }\n\n    var particles = [];\n    function spawnPair(tps, color, mode){\n      var rate = Math.max(tps, 0);\n      var perFrame = Math.min(Math.sqrt(rate)/1.9, 3.5);\n      var n = Math.floor(perFrame) + ((Math.random() < (perFrame % 1)) ? 1 : 0);\n      if (rate < 0.05 &amp;&amp; Math.random() < 0.01) n = 1;\n      for (var i=0;i<n;i++){\n        var jitter = (Math.random()-0.5)*0.75;\n        var sp = 1.3+Math.random()*0.9;\n        var xJitter = (Math.random()-0.5)*14;\n        if (mode === 'both') {\n          particles.push({x:-4-Math.random()*10, lane:'upper', jitter:jitter, speed:sp, color:color, r: 2.0+Math.random()*1.0});\n          particles.push({x:-4-Math.random()*10, lane:'lower', jitter:jitter, speed:sp, color:color, r: 2.0+Math.random()*1.0});\n        } else {\n          particles.push({x: mode.x+xJitter, lane:mode.lane, jitter:jitter, speed:sp, color:color, r: 2.0+Math.random()*1.0});\n        }\n      }\n    }\n\n    ctx.font = '600 11px -apple-system, BlinkMacSystemFont, sans-serif';\n    function nodeBoxWidth(label){ return Math.max(ctx.measureText(label).width + 20, 60); }\n\n    var frame = 0;\n    function draw(){\n      frame++;\n      var w = canvas.width/dpr, h = canvas.height/dpr;\n      var cy = h*0.38;\n      var laneSpan = h*0.26;\n\n      if (trailNeedsReset){\n        ctx.fillStyle = '#0a1420';\n        ctx.fillRect(0,0,w,h);\n        trailNeedsReset = false;\n      } else {\n        ctx.fillStyle = 'rgba(8,17,28,0.40)';\n        ctx.fillRect(0,0,w,h);\n      }\n\n      var steps = 90;\n      ['upper','lower'].forEach(function(lane){\n        ctx.beginPath();\n        var pathPts = [];\n        for (var xi=0; xi<=steps; xi++){\n          var xf = xi/steps;\n          var laneC = laneCenterFrac(xf, lane);\n          var half = bandHalfFrac(xf, lane);\n          pathPts.push([xf*w, cy+(laneC-0.5)*2*laneSpan-half*h]);\n        }\n        for (var xi2=steps; xi2>=0; xi2--){\n          var xf2 = xi2/steps;\n          var laneC2 = laneCenterFrac(xf2, lane);\n          var half2 = bandHalfFrac(xf2, lane);\n          pathPts.push([xf2*w, cy+(laneC2-0.5)*2*laneSpan+half2*h]);\n        }\n        pathPts.forEach(function(pt,i2){ i2===0?ctx.moveTo(pt[0],pt[1]):ctx.lineTo(pt[0],pt[1]); });\n        ctx.closePath();\n        var grad = ctx.createLinearGradient(0,cy-laneSpan*1.3,0,cy+laneSpan*1.3);\n        grad.addColorStop(0,'rgba(52,120,246,0.04)');\n        grad.addColorStop(0.5,'rgba(52,120,246,0.10)');\n        grad.addColorStop(1,'rgba(52,120,246,0.04)');\n        ctx.fillStyle = grad;\n        ctx.fill();\n        ctx.strokeStyle = 'rgba(159,176,194,0.25)';\n        ctx.lineWidth = 1.3;\n        ctx.stroke();\n      });\n\n      spawnPair(acceptTps, '#4a90ff', 'both');\n      spawnPair(execTps, '#33e6a8', {x: 0.48*w, lane:'upper'});\n\n      for (var i=particles.length-1;i>=0;i--){\n        var p = particles[i];\n        var xf = Math.min(Math.max(p.x,0),w)/w;\n        var localCong = congestionAtLane(xf, p.lane);\n        var speedMul = 1 - localCong*0.88;\n        p.x += p.speed*speedMul;\n        if (p.x > w+10) { particles.splice(i,1); continue; }\n        var laneC = laneCenterFrac(xf, p.lane);\n        var half = bandHalfFrac(xf, p.lane);\n        var py = cy + (laneC-0.5)*2*laneSpan + p.jitter*half*h*0.85;\n        ctx.beginPath();\n        ctx.fillStyle = p.color;\n        ctx.shadowColor = p.color;\n        ctx.shadowBlur = speedMul < 0.3 ? 12 : 6;\n        ctx.arc(p.x, py, speedMul < 0.3 ? p.r*1.3 : p.r, 0, Math.PI*2);\n        ctx.fill();\n        ctx.shadowBlur = 0;\n        for (var si=0; si<nodes.length; si++){\n          var nd = nodes[si];\n          if (nd.lane !== 'trunk' &amp;&amp; nd.lane !== p.lane) continue;\n          if (Math.abs(p.x - nd.x*w) < p.speed) glow[si] = 1;\n        }\n      }\n\n      function roundRect(x,y,wd,ht,r){\n        ctx.beginPath();\n        ctx.moveTo(x+r,y);\n        ctx.arcTo(x+wd,y,x+wd,y+ht,r);\n        ctx.arcTo(x+wd,y+ht,x,y+ht,r);\n        ctx.arcTo(x,y+ht,x,y,r);\n        ctx.arcTo(x,y,x+wd,y,r);\n        ctx.closePath();\n      }\n\n      necks.forEach(function(n){\n        var lag = n.key==='m' ? st.mLag : (n.key==='ro' ? st.roLag : st.reLag);\n        var cv = st[n.key];\n        if (cv <= 0.04) return;\n        var nx = n.x*w;\n        var ny = cy + (laneCenterFrac(n.x, n.lane)-0.5)*2*laneSpan;\n        var isExtreme = extreme(n.key, lag);\n        var pulse = isExtreme ? (1 + 0.22*Math.sin(frame/7)) : 1;\n        var color = neckColorFor(n.key, lag);\n        var radius = (10+cv*9)*pulse;\n        var rg = ctx.createRadialGradient(nx,ny,0,nx,ny,radius);\n        rg.addColorStop(0, color);\n        rg.addColorStop(1, 'rgba(0,0,0,0)');\n        ctx.globalAlpha = 0.5;\n        ctx.beginPath();\n        ctx.fillStyle = rg;\n        ctx.arc(nx, ny, radius, 0, Math.PI*2);\n        ctx.fill();\n        ctx.globalAlpha = 1;\n        var badgeY = n.lane === 'upper' ? ny - 30 : ny + 20;\n        var badgeText = '\\uB7ED ' + Math.round(lag) + (isExtreme ? ' \\uD83D\\uDD25' : '');\n        ctx.font = '700 10px -apple-system, BlinkMacSystemFont, sans-serif';\n        var bw = ctx.measureText(badgeText).width + 12;\n        ctx.fillStyle = 'rgba(10,16,24,0.85)';\n        roundRect(nx-bw/2, badgeY-9, bw, 16, 8);\n        ctx.fill();\n        ctx.strokeStyle = color;\n        ctx.lineWidth = 1.2;\n        ctx.stroke();\n        ctx.fillStyle = color;\n        ctx.textAlign = 'center';\n        ctx.fillText(badgeText, nx, badgeY+2);\n      });\n\n      nodes.forEach(function(nd, idx){\n        var nx = nd.x*w;\n        var ny = cy + (laneCenterFrac(nd.x, nd.lane)-0.5)*2*laneSpan;\n        glow[idx] *= 0.94;\n        var g = glow[idx];\n        ctx.font = '700 12px -apple-system, BlinkMacSystemFont, sans-serif';\n        var bw = nodeBoxWidth(nd.label);\n        var bh = 34;\n        var bx = nx - bw/2, by = ny - bh/2;\n        ctx.fillStyle = 'rgba(15,26,40,' + (0.88+g*0.1) + ')';\n        roundRect(bx,by,bw,bh,7);\n        ctx.fill();\n        ctx.strokeStyle = g > 0.05 ? 'rgba(122,190,255,' + (0.4+g*0.6) + ')' : 'rgba(159,176,194,0.35)';\n        ctx.lineWidth = 1.3 + g*1.2;\n        ctx.stroke();\n        ctx.fillStyle = '#e8f1fb';\n        ctx.textAlign = 'center';\n        ctx.font = '700 12px -apple-system, BlinkMacSystemFont, sans-serif';\n        ctx.fillText(nd.label, nx, ny-2);\n        ctx.fillStyle = '#7f93a8';\n        ctx.font = '500 9px -apple-system, BlinkMacSystemFont, sans-serif';\n        ctx.fillText(nd.sub, nx, ny+11);\n      });\n\n      ctx.fillStyle = 'rgba(10,20,32,0.55)';\n      ctx.fillRect(6,6,150,44);\n      ctx.fillStyle = '#cfe6ff';\n      ctx.font = '600 12px -apple-system, BlinkMacSystemFont, sans-serif';\n      ctx.textAlign = 'left';\n      ctx.fillText('\\u25CF 접수 ' + acceptTps.toFixed(1) + '/s', 14, 24);\n      ctx.fillStyle = '#8ff5cf';\n      ctx.fillText('\\u25CF 체결 ' + execTps.toFixed(1) + '/s', 14, 42);\n\n      requestAnimationFrame(draw);\n    }\n    requestAnimationFrame(draw);\n  } catch(e) { if(window.console) console.error('truss-flow error', e); }\n})(this)\"></div>"
      },
      "transparent": true
