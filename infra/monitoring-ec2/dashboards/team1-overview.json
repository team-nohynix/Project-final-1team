{
  "title": "Team1 AI Trader - 실시간 메트릭",
  "uid": "team1-overview",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "개요",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "타겟 상태",
      "type": "stat",
      "gridPos": { "h": 6, "w": 10, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "options": {
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "text": { "titleSize": 16, "valueSize": 24 }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "장애", "color": "red" },
                "1": { "text": "정상", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "up{job=\"k8s-services\", service=~\".*-metrics\"}", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 7,
      "title": "활성 노드 수",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 10, "y": 1 },
      "datasource": "Prometheus",
      "options": { "text": { "titleSize": 16, "valueSize": 36 } },
      "targets": [
        { "expr": "count(up{job=\"k8s-nodes-cadvisor\"} == 1)", "legendFormat": "nodes up" }
      ]
    },
    {
      "id": 205,
      "title": "실행 중인 Pod",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 14, "y": 1 },
      "datasource": "Prometheus",
      "options": { "colorMode": "value", "textMode": "value_and_name" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": { "steps": [ { "color": "purple", "value": null } ] }
        }
      },
      "targets": [
        { "expr": "sum(kube_pod_status_phase{exported_namespace=\"backend\", phase=\"Running\"})", "legendFormat": "pods" }
      ]
    },
    {
      "id": 6,
      "title": "backend 파드 재시작 누적",
      "type": "table",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "cellOptions": { "type": "color-background" } },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_container_status_restarts_total{exported_namespace=\"backend\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "renameByName": { "pod": "파드", "Value": "재시작 횟수" }
          }
        }
      ]
    },

    {
      "id": 111,
      "type": "row",
      "title": "① 주문 접수 API (orderapi)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false
    },
    {
      "id": 301,
      "title": "orderapi 상태",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "options": {
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "text": { "titleSize": 14, "valueSize": 18 }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "장애", "color": "red" },
                "1": { "text": "정상", "color": "green" }
              }
            }
          ],
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "targets": [ { "expr": "up{job=\"k8s-services\", service=\"orderapi-metrics\"}", "legendFormat": "orderapi" } ]
    },
    {
      "id": 2,
      "title": "주문 누적 접수량 (orders_total)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 8 },
      "datasource": "Prometheus",
      "targets": [ { "expr": "orders_total", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 8,
      "title": "주문 접수 속도 (건/초)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 8 },
      "datasource": "Prometheus",
      "targets": [ { "expr": "rate(orders_total[1m])", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 302,
      "title": "주문 접수 API CPU 사용량 (core)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"backend\", container!=\"\", pod=~\"^orderapi-.*\"}[2m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 303,
      "title": "주문 접수 API 메모리 사용량 (working set)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"backend\", container!=\"\", pod=~\"^orderapi-.*\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 304,
      "title": "주문 접수 API 파드 상태 (Running=1)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "kube_pod_status_phase{exported_namespace=\"backend\", phase=\"Running\", pod=~\"^orderapi-.*\"}", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "id": 305,
      "title": "주문 접수 API 재시작 횟수 추이",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "kube_pod_container_status_restarts_total{exported_namespace=\"backend\", pod=~\"^orderapi-.*\"}", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "id": 18,
      "title": "세션 이벤트 (클레임/충돌/하트비트/반납)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "datasource": "Prometheus",
      "targets": [ { "expr": "rate(session_events_total[1m])", "legendFormat": "{{action}}" } ]
    },

    {
      "id": 112,
      "type": "row",
      "title": "② Kafka (MSK)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false
    },
    {
      "id": 209,
      "title": "Kafka 브로커 (orderapi-executions lag)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "options": { "colorMode": "background", "textMode": "value_and_name", "orientation": "horizontal" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 100000 } ] }
        }
      },
      "targets": [
        {
          "region": "ap-northeast-2",
          "namespace": "AWS/Kafka",
          "metricName": "SumOffsetLag",
          "dimensions": {
            "Cluster Name": "team1-truss-msk",
            "Consumer Group": "orderapi-executions",
            "Topic": "executions"
          },
          "statistic": "Average",
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        }
      ]
    },

